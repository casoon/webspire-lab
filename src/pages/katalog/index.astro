---
import { getCollection } from 'astro:content';
import { CATALOG_FAMILY } from '../../content.config';
import Lab from '../../layouts/Lab.astro';

const entries = (await getCollection('catalog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()
);

// Nach Familie gruppieren, in der Reihenfolge des Vokabulars — nicht alphabetisch.
// So steht "form", "table", "error" gleichberechtigt neben "hero" und nicht am Ende.
const groups = CATALOG_FAMILY.map((family) => ({
  family,
  items: entries.filter((entry) => entry.data.family === family),
})).filter((group) => group.items.length > 0);

const missing = CATALOG_FAMILY.filter(
  (family) => !entries.some((entry) => entry.data.family === family)
);
---

<Lab
  title="Katalog"
  lead="Geprüfte Bausteine zum Kopieren. Aufnahme erst nach Tastatur-, Kontrast- und Motion-Prüfung — ein Katalog aus ungeprüften Schnipseln ist eine Haftungsfalle, keine Hilfe."
>
  {
    groups.length === 0 ? (
      <p class="measure text-muted">
        Katalog ist leer. Eintrag anlegen mit <code>/design-catalog-entry</code>.
      </p>
    ) : (
      groups.map((group) => (
        <section class="mt-10 first:mt-0">
          <h2 class="font-head text-h2">{group.family}</h2>
          <ul class="mt-4 grid gap-4 md:grid-cols-2">
            {group.items.map((entry) => (
              <li class="border border-line rounded-ds p-5">
                <h3 class="font-head text-h3">
                  <a href={`/katalog/${entry.id}/`} class="underline-offset-4 hover:underline">
                    {entry.data.title}
                  </a>
                </h3>
                <p class="measure mt-2 text-muted">{entry.data.summary}</p>
                <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 text-micro text-muted">
                  {entry.data.direction.map((direction) => (
                    <li>{direction}</li>
                  ))}
                </ul>
                <p class="mt-3 flex flex-wrap gap-x-4 text-micro">
                  <span class={entry.data.a11yChecked ? 'text-ink' : 'text-muted'}>
                    {entry.data.a11yChecked ? 'a11y geprüft' : 'a11y offen'}
                  </span>
                  <span class="text-muted tabular-nums">
                    {entry.data.jsWeight === 0 ? 'kein Client-JS' : `${entry.data.jsWeight} kB JS`}
                  </span>
                  <span class="text-muted">{entry.data.origin}</span>
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }

  {
    missing.length > 0 && (
      <section class="mt-14 border-t border-line pt-6">
        <h2 class="font-head text-h3">Noch nicht abgedeckt</h2>
        <p class="measure mt-2 text-muted">
          Eine Bibliothek nur aus Heros ist wertlos. Diese Familien fehlen:
        </p>
        <p class="mt-2 text-muted">{missing.join(' · ')}</p>
      </section>
    )
  }
</Lab>
