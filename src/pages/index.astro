---
import Lab from '../layouts/Lab.astro';
import { labState } from '../lib/state';

const state = await labState();
const { projects, references, catalog } = state;

const marker: Record<string, string> = { done: '✓', current: '▸', open: '·' };
---

<Lab
  title="Design-Lab"
  lead="Designrichtungen entstehen durch Bauen, Vergleichen und Verwerfen. Der Stand jedes Projekts ist getrennt sichtbar — das Verfahren steht in design/README.md."
>
  <section aria-labelledby="projects">
    <div class="flex flex-wrap items-baseline justify-between gap-3">
      <h2 id="projects" class="font-head text-h2">Projekte</h2>
      <span class="text-micro text-muted tabular-nums">{projects.length} aktiv oder archiviert</span>
    </div>

    {
      projects.length === 0 ? (
        <div class="mt-4 border border-ink rounded-ds p-6">
          <p class="text-micro text-muted uppercase tracking-wide">Erstes Projekt</p>
          <h3 class="font-head text-h2 mt-1">Briefing anlegen</h3>
          <p class="measure mt-3">Ein Ziel, eine primäre Aktion, echte Zielgruppe.</p>
          <p class="measure mt-2 text-muted">
            Danach erscheinen Projekt und nächster Schritt automatisch in dieser Übersicht.
          </p>
          <p class="mt-5">
            <a href="/start/" class="inline-flex bg-accent px-4 py-2 text-accent-ink rounded-ds">
              Projekt anlegen
            </a>
          </p>
        </div>
      ) : (
        <ol class="mt-4 grid gap-4 lg:grid-cols-2">
          {
            projects.map((project) => (
              <li class="border border-line rounded-ds p-5">
                <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                  <h3 class="font-head text-h3">
                    {
                      project.hasRun ? (
                        <a href={`/lab/${project.slug}/`} class="underline-offset-4 hover:underline">
                          {project.title}
                        </a>
                      ) : (
                        project.title
                      )
                    }
                  </h3>
                  <span class="text-micro text-muted uppercase tracking-wide">
                    {project.status ?? 'ohne Briefing'}
                  </span>
                </div>

                {project.goal && <p class="measure mt-2 text-muted">{project.goal}</p>}

                <ol class="mt-5 flex gap-1" aria-label={`Fortschritt ${project.title}`}>
                  {
                    project.phases.map((phase) => (
                      <li
                        class:list={[
                          'grid size-6 place-items-center rounded-ds text-micro tabular-nums',
                          phase.state === 'done' && 'bg-ink text-bg',
                          phase.state === 'current' && 'bg-accent text-accent-ink',
                          phase.state === 'open' && 'border border-line text-muted',
                        ]}
                        title={`Phase ${phase.n}: ${phase.title}${phase.note ? ` — ${phase.note}` : ''}`}
                      >
                        <span class="sr-only">Phase {phase.n}: {phase.title} — {phase.state}</span>
                        <span aria-hidden="true">{marker[phase.state] === '·' ? phase.n : marker[phase.state]}</span>
                      </li>
                    ))
                  }
                </ol>

                {project.next ? (
                  <div class="mt-5 border-t border-line pt-4">
                    <p class="text-micro text-muted uppercase tracking-wide">
                      Nächster Schritt — Phase {project.next.phase}
                    </p>
                    <h4 class="font-head text-h3 mt-1">{project.next.title}</h4>
                    <p class="measure mt-2">{project.next.action}</p>
                    <p class="measure mt-2 text-muted">{project.next.why}</p>
                    {project.next.command && <p class="mt-4"><code>{project.next.command}</code></p>}
                  </div>
                ) : (
                  <p class="mt-5 border-t border-line pt-4 text-muted">Abgeschlossen und ins Produktionsprojekt übernommen.</p>
                )}
              </li>
            ))
          }
        </ol>
      )
    }
  </section>

  <h2 class="font-head text-h2 mt-14">Wo es klemmt</h2>
  <ul class="measure mt-3 space-y-2 text-muted">
    {
      references.total < references.target && (
        <li>
          Die Referenzbibliothek hat {references.total} von {references.target} Einträgen. Alles
          danach steht auf Vermutungen. → <a href="/referenzen/" class="text-ink underline underline-offset-4">Referenzen</a>
        </li>
      )
    }
    {
      references.total > 0 && references.liveShare < 50 && (
        <li>
          Nur {references.liveShare}% der Referenzen sind reale Websites. Präsentationsdesigns
          kennen keine Fehlerzustände und keine Formulare.
        </li>
      )
    }
    {
      references.missingCritical.length > 0 && references.total > 0 && (
        <li>
          Keine Referenz zeigt {references.missingCritical.join(', ')}. Genau dort scheitern
          generierte Designs.
        </li>
      )
    }
    {
      projects
        .filter((project) => project.directions.length > 0 && project.directions.length < 5)
        .map((project) => (
          <li>
            {project.title} hat {project.directions.length} Richtungen. Der Vergleich trägt erst ab fünf. →{' '}
            <a href={`/lab/${project.slug}/`} class="text-ink underline underline-offset-4">Vergleich</a>
          </li>
        ))
    }
    {
      catalog.unchecked > 0 && (
        <li>
          {catalog.unchecked} Katalogbaustein{catalog.unchecked === 1 ? '' : 'e'} ohne
          a11y-Nachweis. → <a href="/katalog/" class="text-ink underline underline-offset-4">Katalog</a>
        </li>
      )
    }
    {
      catalog.missingFamilies.length > 0 && (
        <li>
          Katalog deckt {catalog.missingFamilies.join(', ')} noch nicht ab.
        </li>
      )
    }
    {
      references.total >= references.target &&
        references.liveShare >= 50 &&
        references.missingCritical.length === 0 &&
        catalog.unchecked === 0 &&
        catalog.missingFamilies.length === 0 && <li class="text-ink">Nichts Offensichtliches.</li>
    }
  </ul>

  <h2 class="font-head text-h2 mt-14">Was dieses Repo nicht ist</h2>
  <ul class="measure mt-3 list-disc space-y-1.5 pl-5 text-muted">
    <li>Keine Komponentenbibliothek zum Installieren — der Katalog wird kopiert und angepasst.</li>
    <li>Keine Sammlung hübscher Voreinstellungen. Die Basis-Tokens sind absichtlich charakterlos.</li>
    <li>Kein Produktionsprojekt. Was hier überzeugt, zieht als Code ins Produktionsprojekt um.</li>
  </ul>
</Lab>
