---
import { CATALOG_FAMILY } from '../../content.config';
import Lab from '../../layouts/Lab.astro';
import { REFERENCE_DIRECTIONS } from '../../lib/references';
---

<Lab title="Referenz erfassen" lead="Halte eine übertragbare Eigenschaft fest. Nicht nachbauen, sondern benennen, was die spätere Gestaltung lernen soll.">
  <form id="reference-form" class="measure border border-ink rounded-ds p-6" novalidate>
    <div class="grid gap-6">
      <div>
        <label for="title" class="font-head text-h3">Titel</label>
        <input id="title" name="title" required class="mt-2 w-full border border-control rounded-ds bg-surface px-3 py-2" />
      </div>
      <div>
        <label for="url" class="font-head text-h3">URL</label>
        <input id="url" name="url" type="url" required class="mt-2 w-full border border-control rounded-ds bg-surface px-3 py-2" placeholder="https://…" />
      </div>
      <div class="grid gap-6 sm:grid-cols-2">
        <div>
          <label for="source-type" class="font-head text-h3">Quelle</label>
          <select id="source-type" name="sourceType" class="mt-2 w-full border border-control rounded-ds bg-surface px-3 py-2">
            <option value="live-site">reale Website</option><option value="shot">Shot / Konzept</option><option value="app">App</option><option value="print">Print</option><option value="other">sonstiges</option>
          </select>
        </div>
        <div>
          <label for="direction" class="font-head text-h3">Leitrichtung</label>
          <select id="direction" name="direction" class="mt-2 w-full border border-control rounded-ds bg-surface px-3 py-2">
            {REFERENCE_DIRECTIONS.map((direction) => <option value={direction}>{direction}</option>)}
          </select>
        </div>
      </div>
      <div class="grid gap-6 sm:grid-cols-3">
        <label class="font-head text-h3">Typografie<select name="typeVoice" class="mt-2 block w-full border border-control rounded-ds bg-surface px-3 py-2"><option value="sans-neutral">sans-neutral</option><option value="serif-display">serif-display</option><option value="grotesk-bold">grotesk-bold</option><option value="mono">mono</option><option value="mixed">mixed</option></select></label>
        <label class="font-head text-h3">Layout<select name="layout" class="mt-2 block w-full border border-control rounded-ds bg-surface px-3 py-2"><option value="single-column">single-column</option><option value="grid-12">grid-12</option><option value="asymmetric">asymmetric</option><option value="split">split</option><option value="broadsheet">broadsheet</option><option value="canvas">canvas</option></select></label>
        <label class="font-head text-h3">Flächen<select name="surface" class="mt-2 block w-full border border-control rounded-ds bg-surface px-3 py-2"><option value="flat">flat</option><option value="bordered">bordered</option><option value="cards">cards</option><option value="layered">layered</option><option value="full-bleed">full-bleed</option></select></label>
      </div>
      <div><label for="takeaway" class="font-head text-h3">Übertragbare Eigenschaft</label><textarea id="takeaway" name="takeaway" required minlength="20" rows="4" class="mt-2 w-full border border-control rounded-ds bg-surface px-3 py-2" placeholder="Zum Beispiel: Der Fließtext bleibt schmal, während Bilder bis an den Rand laufen."></textarea></div>
      <fieldset><legend class="font-head text-h3">Gezeigte Screen-Typen</legend><div class="mt-3 flex flex-wrap gap-x-4 gap-y-2">{CATALOG_FAMILY.map((family) => <label class="flex items-center gap-1.5"><input type="checkbox" name="covers" value={family} /> {family}</label>)}</div></fieldset>
    </div>
    <div class="mt-8 flex flex-wrap items-center gap-4 border-t border-line pt-5"><button type="submit" class="bg-accent px-4 py-2 text-accent-ink rounded-ds">Referenz speichern</button><p id="save-status" class="text-micro text-muted" role="status" aria-live="polite"></p></div>
  </form>
</Lab>

<script>
  const form = document.querySelector<HTMLFormElement>('#reference-form');
  const status = document.querySelector<HTMLElement>('#save-status');
  const slugify = (value: string) => value.toLocaleLowerCase('de-DE').normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form.reportValidity() || !status) return;
    const values = new FormData(form);
    const reference = { schemaVersion: 1, slug: slugify(String(values.get('title'))), title: String(values.get('title')), url: String(values.get('url')), sourceType: String(values.get('sourceType')), capturedAt: new Date().toISOString(), direction: [String(values.get('direction'))], typeVoice: String(values.get('typeVoice')), layout: String(values.get('layout')), surface: String(values.get('surface')), takeaway: String(values.get('takeaway')), covers: values.getAll('covers').map(String) };
    try {
      const response = await fetch('/__lab/references', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(reference) });
      if (response.status === 201) { status.textContent = 'Gespeichert. Referenzbibliothek wird geöffnet.'; window.setTimeout(() => window.location.assign('/referenzen/'), 500); return; }
      const result = await response.json();
      status.textContent = result.error ?? 'Referenz konnte nicht gespeichert werden.';
    } catch { status.textContent = 'Direktes Speichern erfordert pnpm dev.'; }
  });
</script>
