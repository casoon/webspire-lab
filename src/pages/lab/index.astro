---
import Lab from '../../layouts/Lab.astro';
import { getProjects } from '../../lib/projects';

// Läufe werden nicht gepflegt, sondern gefunden: jede Vergleichsseite
// unter src/pages/lab/<slug>/index.astro ist ein Lauf.
// `?raw`, damit kein Seiten-CSS in diese Seite gezogen wird — siehe lib/state.ts.
const runPages = import.meta.glob('/src/pages/lab/*/index.astro', {
  query: '?raw',
  import: 'default',
});
const runSlugs = Object.keys(runPages)
  .map((path) => path.replace('/src/pages/lab/', '').replace('/index.astro', ''))
  .sort();

const briefs = getProjects();
const briefBySlug = new Map(briefs.map((brief) => [brief.slug, brief]));

const statusLabel: Record<string, string> = {
  brief: 'Briefing steht',
  directions: 'Richtungen gebaut',
  refining: 'in Verfeinerung',
  decided: 'entschieden',
  shipped: 'übernommen',
};

const runs = runSlugs.map((slug) => ({ slug, brief: briefBySlug.get(slug) }));
const briefsWithoutRun = briefs.filter((brief) => !runSlugs.includes(brief.slug));
---

<Lab
  title="Lab"
  lead="Ein Lauf pro Projekt. Jeder Lauf zeigt seine Richtungen nebeneinander — einzeln betrachtet täuscht jeder Entwurf."
>
  {
    runs.length === 0 ? (
      <p class="measure text-muted">
        Noch kein Lauf. Briefing anlegen mit <code>/design-brief</code>, danach Richtungen bauen mit{' '}
        <code>/design-directions-lab</code>.
      </p>
    ) : (
      <ul class="grid gap-4 md:grid-cols-2">
        {runs.map(({ slug, brief }) => (
          <li class="border border-line rounded-ds p-5">
            <h2 class="font-head text-h3">
              <a href={`/lab/${slug}/`} class="underline-offset-4 hover:underline">
                {brief?.title ?? slug}
              </a>
            </h2>
            {brief && (
              <>
                <p class="mt-1 text-micro text-muted uppercase tracking-wide">
                  {brief.client} · {statusLabel[brief.status] ?? brief.status}
                </p>
                <p class="measure mt-3 text-muted">{brief.goal}</p>
                <p class="mt-3 text-micro text-muted">
                  Primäre Aktion: <span class="text-ink">{brief.primaryAction}</span>
                </p>
                {brief.chosenDirection && (
                  <p class="mt-1 text-micro text-muted">
                    Gewählt: <span class="text-ink">{brief.chosenDirection}</span>
                  </p>
                )}
              </>
            )}
            {!brief && (
              <p class="mt-3 text-micro text-muted">
                Keine Projektdatei unter <code>lab.config/projects/{slug}.json</code> — ohne Briefing ist der Vergleich
                nicht bewertbar.
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }

  {
    briefsWithoutRun.length > 0 && (
      <>
        <h2 class="font-head text-h2 mt-14">Briefing ohne Richtungen</h2>
        <ul class="mt-3 space-y-1.5 text-muted">
          {briefsWithoutRun.map((brief) => (
            <li>
              <code>lab.config/projects/{brief.slug}.json</code> — {brief.title}
            </li>
          ))}
        </ul>
      </>
    )
  }
</Lab>
