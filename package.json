{
  "name": "@webspire/lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Design-Lab und Vorlagen-Katalog — Designrichtungen erzeugen, vergleichen, verfeinern und als Vorlage archivieren.",
  "license": "Apache-2.0",
  "author": "Jörn Seidel",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "type-check": "astro check",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test:a11y": "pnpm build && playwright test a11y",
    "test:shots": "pnpm build && playwright test screenshots",
    "test:e2e": "pnpm build && playwright test",
    "analyze": "fallow",
    "clean": "rm -rf dist .astro"
  },
  "dependencies": {
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "fallow": "^3.9.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
